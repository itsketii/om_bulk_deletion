# ---------------------------------------------------------------------------
# OM Bulk Deletion Portal — root .gitignore
# Safety net: each sub-project also has its own .gitignore.
# ---------------------------------------------------------------------------

# Dependencies
om-bulk-operations-backend/node_modules/
om-bulk-deletion-portal/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build / cache
om-bulk-operations-backend/.next/
out/
build/
dist/
coverage/
*.tsbuildinfo
.turbo/
.cache/

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/

# Seeded plaintext admin password (generated by scripts/seed-admin.js)
admin-credentials.txt
admin-credentials*.txt

# Runtime artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pids/
*.pid
*.seed

# Uploaded / generated user data (should never leak into git)


tmp/

# IDE / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Vercel
.vercel
